{
  "name": "heistworkspace",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.node.json",
    "preview": "vite preview",
    "dev:lan": "vite --host",
    "serve": "node server/index.ts",
    "lan": "npm run build && npm run serve"
  },
  "dependencies": {
